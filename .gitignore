# Design notes (local planning artifacts)
.design

# Agent session scratch (plans, captures)
.omp/

# Git worktrees: one per unit of work, under the repo root. Without this the
# parent repo sees a whole nested checkout as untracked content and a stray
# `git add -A` stages an entire second copy of the tree.
.git-worktrees/

# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
build/
.eggs/
MANIFEST
python/.venv/
python/uv.lock.bak

# uv / tool caches
.uv/
.pytest_cache/
.mypy_cache/
.dmypy.json
