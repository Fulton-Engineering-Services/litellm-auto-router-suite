.nox/

# Node
node_modules/
.pnpm-store/
pnpm-debug.log
*.tsbuildinfo

# Build output
dist/
# Anchored to typescript/ on purpose. A bare `lib/` matches a directory named lib
# at ANY depth, which silently swallows scripts/lib/ -- the operators' library
# every driver sources and that lefthook's pre-commit job depends on. tsc emits
# lib/ and lib-tests/ as package output directories under the pnpm workspace.
typescript/**/lib/
typescript/**/lib-tests/
out/
coverage/

# Bazel
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-litellm-auto-router-suite
/.bazelrc.user

